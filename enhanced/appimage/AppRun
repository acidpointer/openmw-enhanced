#!/usr/bin/env sh
set -eu

APPDIR="$(dirname "$(readlink -f "$0")")"

export LD_LIBRARY_PATH="${APPDIR}/usr/lib:${APPDIR}/usr/lib/x86_64-linux-gnu:${LD_LIBRARY_PATH:-}"
export OSG_LIBRARY_PATH="${APPDIR}/usr/lib/osgPlugins:${OSG_LIBRARY_PATH:-}"
export QT_PLUGIN_PATH="${APPDIR}/usr/plugins:${APPDIR}/usr/lib/qt6/plugins:${APPDIR}/usr/lib/x86_64-linux-gnu/qt6/plugins:${QT_PLUGIN_PATH:-}"
export XDG_DATA_DIRS="${APPDIR}/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

if [ "$#" -gt 0 ] && [ "$1" = "--openmw" ]; then
    shift
    exec "${APPDIR}/usr/bin/openmw" \
        --resources "${APPDIR}/usr/share/games/openmw/resources" \
        "$@"
fi

exec "${APPDIR}/usr/bin/openmw-launcher" "$@"
