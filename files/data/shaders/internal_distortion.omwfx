uniform_vec4 enhancedDistortionCoverage {
    default = vec4(0.0, 0.0, 1.0, 1.0);
    static = false;
}

fragment main {

    omw_In vec2 omw_TexCoord;

    void main()
    {
        const float multiplier = 0.14;

        if (any(lessThan(omw_TexCoord, enhancedDistortionCoverage.xy))
            || any(greaterThan(omw_TexCoord, enhancedDistortionCoverage.zw)))
        {
            omw_FragColor = omw_GetLastShader(omw_TexCoord);
            return;
        }

        vec2 offset = omw_GetDistortion(omw_TexCoord).rg;
        offset *= multiplier;
        offset = clamp(offset, vec2(-1.0), vec2(1.0));

        float occlusionFactor = omw_GetDistortion(omw_TexCoord+offset).b;

        omw_FragColor = mix(omw_GetLastShader(omw_TexCoord + offset), omw_GetLastShader(omw_TexCoord), occlusionFactor);
    }
}

technique {
    description = "Internal refraction shader for OpenMW";
    version = "1.0";
    author = "OpenMW";
    passes = main;
    flags = hidden;
}
